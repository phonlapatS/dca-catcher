# ==========================================
# DCA Catcher — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control!
# ==========================================

# 1. Telegram Bot Credentials
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Google Gemini AI API Keys
# Obtain your API keys from Google AI Studio (comma-separated for key rotation)
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"

# 3. Database Configuration
# Connection string for your database. 
# For local development: sqlite+aiosqlite:///dca_catcher.db
# For production (Supabase/PostgreSQL): postgresql+asyncpg://user:password@host:6543/postgres?pgbouncer=true
DATABASE_URL="sqlite+aiosqlite:///dca_catcher.db"

# 4. Broadcast Channel
# Telegram Channel or Group ID for automated daily market reports (e.g. -100xxxxxxxxxx)
BROADCAST_CHANNEL_ID="-100xxxxxxxxxx"

# 5. Alpaca Market Data (for Real-time US WebSocket Price Stream)
# Obtain your API Key and Secret from Alpaca Markets Dashboard (Paper or Live)
ALPACA_API_KEY="your_alpaca_api_key_here"
ALPACA_SECRET_KEY="your_alpaca_secret_key_here"

# Alpaca Sniper Operating Hours (Bangkok Time UTC+7)
ALPACA_SNIPER_START="20:30"
ALPACA_SNIPER_END="04:00"

# 6. External Webhook Server Configuration (for TradingView Alerts)
# Port for the internal aiohttp server to listen on
WEBHOOK_PORT=8080

# Secret key required in the webhook URL (e.g. POST /webhook/<WEBHOOK_SECRET>)
WEBHOOK_SECRET="your_custom_secure_secret_token"
